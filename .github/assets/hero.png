<svg xmlns="http://www.w3.org/2000/svg" width="800" height="320" viewBox="0 0 800 320">
  <rect width="800" height="320" fill="#0d1117"/>
  <!-- Background pattern -->
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#1f2428" stroke-width="0.5"/>
    </pattern>
  </defs>
  <rect width="800" height="320" fill="url(#grid)"/>

  <!-- Title -->
  <text x="400" y="100" text-anchor="middle" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-size="48" font-weight="700" letter-spacing="-1">hermes-brain</text>

  <!-- Subtitle -->
  <text x="400" y="145" text-anchor="middle" fill="#8b949e" font-family="system-ui, -apple-system, sans-serif" font-size="18">Persistent long-term memory for Hermes agents</text>

  <!-- Database icons row -->
  <g transform="translate(120, 180)">
    <!-- Memory -->
    <g transform="translate(0, 0)">
      <rect x="0" y="0" width="80" height="80" rx="12" fill="#1f2428" stroke="#30363d" stroke-width="1"/>
      <text x="40" y="35" text-anchor="middle" fill="#f0883e" font-size="28">🧠</text>
      <text x="40" y="62" text-anchor="middle" fill="#8b949e" font-family="system-ui" font-size="11">Memory</text>
    </g>
    <!-- Tasks -->
    <g transform="translate(95, 0)">
      <rect x="0" y="0" width="80" height="80" rx="12" fill="#1f2428" stroke="#30363d" stroke-width="1"/>
      <text x="40" y="35" text-anchor="middle" fill="#3fb950" font-size="28">✓</text>
      <text x="40" y="62" text-anchor="middle" fill="#8b949e" font-family="system-ui" font-size="11">Tasks</text>
    </g>
    <!-- Projects -->
    <g transform="translate(190, 0)">
      <rect x="0" y="0" width="80" height="80" rx="12" fill="#1f2428" stroke="#30363d" stroke-width="1"/>
      <text x="40" y="35" text-anchor="middle" fill="#58a6ff" font-size="28">📁</text>
      <text x="40" y="62" text-anchor="middle" fill="#8b949e" font-family="system-ui" font-size="11">Projects</text>
    </g>
    <!-- Content -->
    <g transform="translate(285, 0)">
      <rect x="0" y="0" width="80" height="80" rx="12" fill="#1f2428" stroke="#30363d" stroke-width="1"/>
      <text x="40" y="35" text-anchor="middle" fill="#a371f7" font-size="28">📝</text>
      <text x="40" y="62" text-anchor="middle" fill="#8b949e" font-family="system-ui" font-size="11">Content</text>
    </g>
    <!-- Research -->
    <g transform="translate(380, 0)">
      <rect x="0" y="0" width="80" height="80" rx="12" fill="#1f2428" stroke="#30363d" stroke-width="1"/>
      <text x="40" y="35" text-anchor="middle" fill="#f78166" font-size="28">🔬</text>
      <text x="40" y="62" text-anchor="middle" fill="#8b949e" font-family="system-ui" font-size="11">Research</text>
    </g>
    <!-- Career -->
    <g transform="translate(475, 0)">
      <rect x="0" y="0" width="80" height="80" rx="12" fill="#1f2428" stroke="#30363d" stroke-width="1"/>
      <text x="40" y="35" text-anchor="middle" fill="#7ee787" font-size="28">💼</text>
      <text x="40" y="62" text-anchor="middle" fill="#8b949e" font-family="system-ui" font-size="11">Career</text>
    </g>
    <!-- Entities -->
    <g transform="translate(570, 0)">
      <rect x="0" y="0" width="80" height="80" rx="12" fill="#1f2428" stroke="#30363d" stroke-width="1"/>
      <text x="40" y="35" text-anchor="middle" fill="#ffa657" font-size="28">👥</text>
      <text x="40" y="62" text-anchor="middle" fill="#8b949e" font-family="system-ui" font-size="11">Entities</text>
    </g>
  </g>

  <!-- Flow diagram -->
  <g transform="translate(100, 280)">
    <text x="0" y="0" fill="#8b949e" font-family="system-ui" font-size="12">Conversation → Classify → Normalize → Notion API → 7 Databases</text>
  </g>

  <!-- Bottom badges -->
  <g transform="translate(100, 305)">
    <text x="0" y="0" fill="#8b949e" font-family="system-ui" font-size="11">Python 3.10+  •  Notion API  •  Hermes Agent Plugin  •  MIT License</text>
  </g>
</svg>